# ─────────────────────────────────────────────────────────────────────
# eComProtect backend — environment variables
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# All keys without a default below are required (validated in src/utils/env.util.ts).
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
AUTO_ACTIVATION=false

# ── Domains ───────────────────────────────────────────────────────────
# Public origin of the frontend (where Shopify redirects merchants back to).
FRONTEND_DOMAIN=https://app.ecomprotect.co.uk
BACKEND_DOMAIN=https://api.ecomprotect.co.uk

# ── Database (Postgres / Neon) ────────────────────────────────────────
CONNECTION_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_NAME=neondb

# ── Secrets ───────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
COOKIE_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=          # 32-byte hex string used to encrypt stored Shopify tokens

# ── Shopify embedded app ──────────────────────────────────────────────
SHOPIFY_API_KEY=         # Client ID (public)
SHOPIFY_API_SECRET=      # Client secret (private)
SHOPIFY_APP_URL=https://api.ecomprotect.co.uk   # Public HTTPS origin of this backend, no trailing slash

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SendGrid + Brevo) ──────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_SENDER_NAME=
SENDGRID_SENDER_EMAIL=
BREVO_EMAIL=
BREVO_API_KEY=

# ── Cloudinary (avatars/uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
GC_ACCESS_TOKEN=
GC_WEBHOOK_SECRET=
GC_ENV=sandbox           # "sandbox" | "live"

# ── Web push (VAPID) ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
